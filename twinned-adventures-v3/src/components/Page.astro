---

import '../styles/global.css';
import Form from './Form.astro';
import {content} from '../lib/content';
import {loadTour} from '../lib/sanity';
const {lang='es'} = Astro.props;
const cms=await loadTour();
const t=JSON.parse(JSON.stringify(content[lang as 'es'|'en']));
const tour=cms?.tour;
const localized=(v:any)=>v?.[lang];
if(tour){if(localized(tour.heroTitle))t.title=localized(tour.heroTitle);if(localized(tour.heroSubtitle))t.intro=localized(tour.heroSubtitle);if(tour.itinerary?.length)t.steps=tour.itinerary.map((x:any)=>localized(x.title)).filter(Boolean);if(tour.included?.length)t.includedItems=tour.included.map((x:any)=>localized(x.label)).filter(Boolean);if(tour.excluded?.length)t.excludedItems=tour.excluded.map((x:any)=>localized(x.label)).filter(Boolean);if(localized(tour.cancellationPolicy))t.policy=localized(tour.cancellationPolicy);}
if(cms?.faq?.length)t.faqs=cms.faq.map((x:any)=>[localized(x.question),localized(x.answer)]).filter((x:any)=>x[0]&&x[1]);
const price=typeof tour?.price==='number'?tour.price:100;
const facts=[tour?.duration,tour?.difficulty,tour?.minimumAge,tour?.schedules?.join(' · '),localized(tour?.meetingPoint),tour?.availableSpaces];
const en=t.lang==='en';
const sampleReviews=[
 {name:en?'Ana · Sample review':'Ana · Opinión de ejemplo',rating:5,message:en?'The rapids, the rainforest and paddling together made this an unforgettable adventure. We finished soaked and smiling.':'Los rápidos, la selva y remar en equipo hicieron de esta aventura un recuerdo inolvidable. Terminamos empapados y felices.',title:en?'Pure excitement, down the river.':'Pura emoción, río abajo.'},
 {name:en?'Daniel · Sample review':'Daniel · Opinión de ejemplo',rating:5,message:en?'I was nervous about rafting for the first time. The briefing helped me feel ready, and sharing the descent with the group was the best part.':'Me daba nervios hacer rafting por primera vez. La charla me ayudó a sentirme preparado y compartir el descenso con el grupo fue lo mejor.',title:en?'A first adventure to remember.':'Una primera aventura para recordar.'},
 {name:en?'Sofía · Sample review':'Sofía · Opinión de ejemplo',rating:5,message:en?'A great way to switch off: green scenery, splashing water and a team cheering through every rapid. I would love to do it again.':'Una forma increíble de desconectarse: paisajes verdes, agua salpicando y un equipo celebrando cada rápido. Me encantaría repetirlo.',title:en?'Nature and adventure together.':'Naturaleza y aventura juntas.'}
];
const hasRealReviews=Boolean(cms?.reviews?.length);
const displayReviews=hasRealReviews?cms.reviews:sampleReviews;
const tabs=[['included',en?'Your tour':'Tu tour'],['itinerary',t.nav[1]],['safety',t.nav[2]],['pack',en?'What to bring':'Qué llevar'],['reviews',t.nav[4]]];
const phone=(cms?.settings?.whatsapp||import.meta.env.PUBLIC_WHATSAPP)?.replace(/\D/g,'');
const wa=phone?`https://wa.me/${phone}`:'#contact';

---
<!doctype html><html lang={t.lang} data-theme="twinned"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>Twinned Adventures | Rafting Costa Rica</title><meta name="description" content={t.intro}/><meta property="og:title" content="Twinned Adventures · Rafting"/><meta property="og:description" content={t.intro}/><meta property="og:type" content="website"/><link rel="icon" href="/media/river.svg"/>{import.meta.env.PUBLIC_SITE_URL && <><link rel="canonical" href={`${import.meta.env.PUBLIC_SITE_URL}/${t.lang}/`}/><link rel="alternate" hreflang="es" href={`${import.meta.env.PUBLIC_SITE_URL}/es/`}/><link rel="alternate" hreflang="en" href={`${import.meta.env.PUBLIC_SITE_URL}/en/`}/></>}{import.meta.env.PUBLIC_TURNSTILE_SITE_KEY && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}</head><body class="compact">
<a class="skip" href="#main">{en?'Skip to content':'Ir al contenido'}</a>
<header><a class="brand" href={`/${t.lang}/`} aria-label="Twinned Adventures"><span class="brand-mark">≋</span><span>TWINNED<small>ADVENTURES</small></span></a><nav aria-label={en?'Main navigation':'Navegación principal'}><a href="#experience">{t.nav[0]}</a><a href="#details">{en?'Tour details':'El tour'}</a><a href="#faq">{t.nav[5]}</a><a href="#tracking" data-open="tracking">{en?'My booking':'Mi reservación'}</a></nav><div class="nav-actions"><a class="language" href={en?'/es/':'/en/'}>{en?'ES':'EN'}</a><a class="btn btn-primary nav-book" href="#booking" data-open="booking">{t.book} ↗</a><button class="menu-toggle btn" aria-label={en?'Open menu':'Abrir menú'} aria-expanded="false">☰</button></div></header>
<div class="mobile-menu" hidden><a href="#experience">{t.nav[0]}</a><a href="#details">{en?'Tour details':'El tour'}</a><a href="#faq">{t.nav[5]}</a><a href="#tracking" data-open="tracking">{en?'My booking':'Mi reservación'}</a><a href="#contact" data-open="contact">{t.nav[6]}</a></div>
<main id="main"><section class="hero" aria-label={en?'River adventure':'Aventura río abajo'}>
<img class="hero-bg hero-fallback" src="/media/hero-poster.webp" alt="" fetchpriority="high" width="1600" height="892"/>
<video id="hero-video" class="hero-bg hero-film" autoplay muted loop playsinline preload="auto" poster="/media/hero-poster.webp" aria-hidden="true" tabindex="-1" ><source src="/media/hero-river-mobile.mp4" type="video/mp4" media="(max-width: 767px)"/><source src="/media/hero-river.mp4" type="video/mp4"/></video>
<div class="hero-content"><p class="eyebrow">COSTA RICA · RIVER ADVENTURES</p><h1>{en?'Feel the rush.':'Sentí el río.'}<br/><em>{en?'Go wild.':'Viví la aventura.'}</em></h1><p class="hero-description">{en?'Whitewater. Rainforest. Pure adrenaline. Your next great story starts down the river.':'Rápidos. Selva. Pura emoción. Tu próxima gran historia comienza río abajo.'}</p><div class="hero-buttons"><a class="btn btn-primary" href="#booking" data-open="booking">{t.book} ↗</a><a class="btn btn-ghost" href={wa} data-open={!phone?'contact':undefined}>{t.whatsapp}</a></div><p class="hero-price"><b>${price}</b> <span>USD / {t.price}</span></p></div>
<button id="motion-toggle" class="motion-toggle" type="button" aria-label={en?'Pause videos':'Pausar videos'} data-pause={en?'Pause videos':'Pausar videos'} data-resume={en?'Resume videos':'Reanudar videos'}>Ⅱ</button>
<div class="hero-bottom"><a href="#experience">{en?'Discover the adventure':'Conocé la aventura'} ↓</a><span>{en?'Illustrative stock footage':'Video de referencia'}</span></div></section>
<div class="quick-bar"><div class="wrap"><span>↟ {en?'Tropical scenery':'Paisajes tropicales'}</span><span>≋ {en?'River rafting':'Rafting río abajo'}</span><span>↗ {en?'Shared adventure':'Aventura en equipo'}</span><span>$ {price} USD / {t.price}</span></div></div>
<section id="experience" class="wrap section tour-overview"><div class="tour-story"><p class="eyebrow">ONE RIVER. ONE GREAT ADVENTURE.</p><h2>{en?'Less routine.':'Menos rutina.'}<br/><em>{en?'More adventure.':'Más aventura.'}</em></h2><p>{en?'Paddle together, feel the rapids, and discover the energy of the river. One tour designed to make room for a great memory.':'Remá en equipo, sentí los rápidos y disfrutá de la energía del río. Un único tour para desconectarte y vivir un gran recuerdo.'}</p><div class="mini-photo"><video id="experience-video" autoplay muted loop playsinline preload="auto" poster="/media/rafting-team.webp" aria-hidden="true" tabindex="-1"><source src="/media/rafting-experience.mp4" type="video/mp4"/></video><span class="clip-caption">{en?'The adventure, in motion':'La aventura, en movimiento'}</span></div></div>
<article class="price-card"><span>RAFTING · TWINNED ADVENTURES</span><div class="big-price">${price}<small>USD / {t.price}</small></div><p>{en?'Request your spot. Our team will confirm availability and help you arrange the details.':'Solicitá tu espacio. Nuestro equipo confirmará la disponibilidad y te ayudará a coordinar los detalles.'}</p><div class="price-highlights">{t.includedItems.slice(0,4).map((x:string)=><span>✓ {x}</span>)}</div><p class="note">{t.policy}</p><a class="btn btn-primary" href="#booking" data-open="booking">{t.book} ↗</a><a href={wa} data-open={!phone?'contact':undefined} class="text-link">{t.whatsapp}</a><div class="booking-reminder">{en?'Submitting a request does not confirm your booking.':'Enviar una solicitud no confirma la reservación.'}</div></article></section>
<section id="details" class="details-section"><div class="wrap"><div class="details-heading"><p class="eyebrow">{en?'EVERYTHING YOU NEED TO KNOW':'TODO LO QUE NECESITÁS SABER'}</p><p>{en?'Explore the details before you paddle.':'Conocé los detalles antes de remar.'}</p></div><div class="tour-tabs" role="tablist" aria-label={en?'Tour information':'Información del tour'}>{tabs.map(([id,label],i)=><button id={`tab-${id}`} role="tab" aria-controls={`panel-${id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?0:-1} type="button">{label}</button>)}</div>
<div class="tab-content" id="panel-included" role="tabpanel" aria-labelledby="tab-included" tabindex="0"><div class="detail-columns"><article><h3>{t.included}</h3><ul>{t.includedItems.map((x:string)=><li>✓ {x}</li>)}</ul></article><article><h3>{t.excluded}</h3><ul>{t.excludedItems.map((x:string)=><li>↗ {x}</li>)}</ul></article><article><h3>{en?'Route information':'Datos del recorrido'}</h3><ul>{t.facts.slice(0,5).map((x:string,i:number)=><li><b>{x}:</b> {facts[i]??t.pending}</li>)}</ul></article></div></div>
<div class="tab-content" id="panel-itinerary" role="tabpanel" aria-labelledby="tab-itinerary" tabindex="0" hidden><ol class="compact-itinerary">{t.steps.map((step:string,i:number)=><li><span>{String(i+1).padStart(2,'0')}</span><p>{step}</p></li>)}</ol></div>
<div class="tab-content" id="panel-safety" role="tabpanel" aria-labelledby="tab-safety" tabindex="0" hidden><div class="detail-columns safety-content"><div><h3>{t.safety}</h3><p>{t.safetyText}</p></div><ul>{t.safetyPoints.map((x:string)=><li>✓ {x}</li>)}</ul><p class="note">{t.safetyNote}</p></div></div>
<div class="tab-content" id="panel-pack" role="tabpanel" aria-labelledby="tab-pack" tabindex="0" hidden><div class="pack-grid">{t.packItems.map((x:string,i:number)=><article><span>{['◈','↟','↔','▤','☀','◉','▱','✚'][i]}</span><p>{x}</p></article>)}</div></div>
<div class="tab-content" id="panel-reviews" role="tabpanel" aria-labelledby="tab-reviews" tabindex="0" hidden>{cms?.reviews?.length?<div class="review-cards">{cms.reviews.map((r:any)=><article><h3>{r.name}</h3><p>{r.rating} / 5 · {r.country}</p><p>{r.message}</p>{r.verified&&<small>{en?'Verified review':'Opinión verificada'}</small>}{r.response&&<p>{r.response}</p>}</article>)}</div>:<p>{t.reviewsText}</p>}<button type="button" class="text-link" data-open="review">{t.reviewButton} ↗</button></div>
</div></section>
<section id="reviews" class="review-invite testimonials"><div class="wrap"><div class="testimonial-heading"><div><p class="eyebrow">{en?'TRAVELER REVIEWS':'OPINIONES DE VIAJEROS'}</p><h2>{en?'Adventure worth talking about.':'Una aventura que se cuenta.'}</h2><p>{hasRealReviews?(en?'Stories shared by our travelers.':'Experiencias compartidas por nuestros viajeros.'):(en?'Sample reviews to preview the design. These are not real customer testimonials.':'Opiniones de muestra para visualizar el diseño. No son testimonios de clientes reales.')}</p></div><button type="button" class="btn btn-outline" data-open="review">{en?'Write my review':'Escribir mi comentario'} ↗</button></div><div class="testimonial-cards">{displayReviews.slice(0,3).map((r:any)=><article><div class="stars" aria-label={`${r.rating} / 5`}>{'★'.repeat(r.rating)}<span>{'☆'.repeat(5-r.rating)}</span></div><h3>{r.title||r.name}</h3><p>{r.message}</p><div class="review-author">{r.title&&<strong>{r.name}</strong>}{!hasRealReviews?<small>{en?'Design sample':'Muestra de diseño'}</small>:r.verified&&<small>{en?'Verified review':'Opinión verificada'}</small>}</div>{r.response&&<p class="review-response">{r.response}</p>}</article>)}</div></div></section>
<section id="faq" class="wrap section compact-faq"><div><p class="eyebrow">FAQ</p><h2>{en?'Before you':'Antes de'}<br/><em>{en?'jump in.':'la aventura.'}</em></h2><p>{en?'Have another question? We can help.':'¿Tenés otra pregunta? Te ayudamos.'}</p><button type="button" class="text-link" data-open="contact">{en?'Talk to us':'Conversemos'} ↗</button></div><div class="faqs">{t.faqs.slice(0,4).map(([q,a]:string[])=><details><summary>{q}<span>+</span></summary><p>{a}</p></details>)}<details><summary>{en?'Booking, cancellations and other questions':'Reservas, cancelaciones y más preguntas'}<span>+</span></summary>{t.faqs.slice(4).map(([q,a]:string[])=><article><h3>{q}</h3><p>{a}</p></article>)}</details></div></section>
</main><footer class="wrap compact-footer"><div><a class="brand" href={`/${t.lang}/`}><span class="brand-mark">≋</span><span>TWINNED<small>ADVENTURES</small></span></a><p>{t.footer}</p></div><div><a href="#tracking" data-open="tracking">{en?'Check my booking':'Consultar mi reservación'}</a><a href="#contact" data-open="contact">{t.nav[6]}</a><a href="#reviews">{t.nav[4]}</a><a href={`/${t.lang}/policies/`}>{t.legal.join(' · ')}</a><small>© {new Date().getFullYear()} Twinned Adventures</small><small>{en?'Stock footage':'Videos de referencia'}: <a href="https://pixabay.com/videos/river-rafting-whitewater-rapids-pov-322230/" target="_blank" rel="noopener">Solarselle77 / Pixabay</a> · <a href="https://www.pexels.com/video/a-group-of-people-rafting-the-rapids-2286303/" target="_blank" rel="noopener">K / Pexels</a></small></div></footer>
<div class="mobile-book"><span><b>${price}</b> <small>USD / {t.price}</small></span><a class="btn btn-primary" href="#booking" data-open="booking">{en?'Book now':'Reservar'} ↗</a></div><a class="floating" href={wa} data-open={!phone?'contact':undefined} aria-label={t.whatsapp}>↗ <span>WhatsApp</span></a>
<dialog id="booking" class="form-dialog" aria-labelledby="booking-title"><button class="dialog-close" type="button" aria-label={en?'Close':'Cerrar'}>×</button><p class="eyebrow">RAFTING · ${price} USD</p><h2 id="booking-title">{en?'Your adventure.':'Tu aventura.'}</h2><p>{t.reserveText}</p><Form t={t}/></dialog>
<dialog id="tracking" class="form-dialog" aria-labelledby="tracking-title"><button class="dialog-close" type="button" aria-label={en?'Close':'Cerrar'}>×</button><h2 id="tracking-title">{en?'Your booking.':'Tu reservación.'}</h2><p>{t.trackingText}</p><Form t={t} kind="tracking"/><details><summary>{t.form.query}</summary><Form t={t} kind="inquiry"/></details></dialog>
<dialog id="review" class="form-dialog" aria-labelledby="review-title"><button class="dialog-close" type="button" aria-label={en?'Close':'Cerrar'}>×</button><h2 id="review-title">{t.reviewButton}</h2><p>{en?'Your review will be checked before publication.':'Tu opinión se revisará antes de publicarla.'}</p><Form t={t} kind="review"/></dialog>
<dialog id="contact" class="form-dialog" aria-labelledby="contact-title"><button class="dialog-close" type="button" aria-label={en?'Close':'Cerrar'}>×</button><h2 id="contact-title">{en?'Let’s talk.':'Conversemos.'}</h2><p>{t.contactText}</p><Form t={t} kind="contact"/></dialog>
<noscript><div class="wrap"><p>{en?'Enable JavaScript to open booking forms.':'Activá JavaScript para abrir los formularios.'}</p></div></noscript>
<script>
const menu=document.querySelector<HTMLButtonElement>('.menu-toggle');const mobile=document.querySelector<HTMLDivElement>('.mobile-menu');menu?.addEventListener('click',()=>{if(!mobile)return;mobile.hidden=!mobile.hidden;menu.setAttribute('aria-expanded',String(!mobile.hidden))});mobile?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{mobile.hidden=true;menu?.setAttribute('aria-expanded','false')}));
const videos=Array.from(document.querySelectorAll<HTMLVideoElement>('video'));const motion=document.querySelector<HTMLButtonElement>('#motion-toggle');let userPaused=false;
function startVideos(){videos.forEach(video=>{video.muted=true;video.defaultMuted=true;video.play().catch(()=>{ /* Keep the poster when the browser prevents autoplay. */ })})}
startVideos();
videos.forEach(video=>{video.addEventListener('canplay',()=>{if(!userPaused&&!document.hidden)video.play().catch(()=>{})},{once:true});video.addEventListener('error',()=>video.classList.add('video-unavailable'))});
motion?.addEventListener('click',()=>{userPaused=!userPaused;if(userPaused)videos.forEach(video=>video.pause());else startVideos();motion.textContent=userPaused?'↻':'Ⅱ';motion.setAttribute('aria-label',userPaused?motion.dataset.resume!:motion.dataset.pause!);motion.setAttribute('aria-pressed',String(userPaused))});
document.addEventListener('visibilitychange',()=>{if(document.hidden)videos.forEach(video=>video.pause());else if(!userPaused)startVideos()});
document.querySelectorAll<HTMLElement>('[data-open]').forEach(trigger=>trigger.addEventListener('click',event=>{const dialog=document.getElementById(trigger.dataset.open!) as HTMLDialogElement|null;if(!dialog)return;event.preventDefault();dialog.showModal();document.body.classList.add('modal-open');}));
document.querySelectorAll<HTMLDialogElement>('dialog').forEach(dialog=>{dialog.querySelector('.dialog-close')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',e=>{if(e.target!==dialog)return;const rect=dialog.getBoundingClientRect();const click=e as MouseEvent;if(click.clientX<rect.left||click.clientX>rect.right||click.clientY<rect.top||click.clientY>rect.bottom)dialog.close()});dialog.addEventListener('close',()=>{document.body.classList.remove('modal-open');})});
const tabs=Array.from(document.querySelectorAll<HTMLButtonElement>('[role=tab]'));function activate(tab:HTMLButtonElement){tabs.forEach(t=>{const active=t===tab;t.setAttribute('aria-selected',String(active));t.tabIndex=active?0:-1;const panel=document.getElementById(t.getAttribute('aria-controls')!);if(panel)panel.hidden=!active})}tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>activate(tab));tab.addEventListener('keydown',e=>{let next:number|undefined;if(e.key==='ArrowRight')next=(i+1)%tabs.length;if(e.key==='ArrowLeft')next=(i-1+tabs.length)%tabs.length;if(e.key==='Home')next=0;if(e.key==='End')next=tabs.length-1;if(next!==undefined){e.preventDefault();activate(tabs[next]);tabs[next].focus()}})});
document.querySelectorAll<HTMLFormElement>('form[data-kind]').forEach(form=>{const date=form.querySelector<HTMLInputElement>('input[type=date]');if(date&&form.dataset.kind==='booking'){const now=new Date();date.min=`${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;}form.addEventListener('submit',async e=>{e.preventDefault();const en=form.dataset.lang==='en';const status=form.querySelector<HTMLElement>('.form-status')!;const button=form.querySelector<HTMLButtonElement>('button[type=submit]')!;button.disabled=true;status.textContent=en?'Sending…':'Enviando…';try{const data=Object.fromEntries(new FormData(form));const response=await fetch(`/api/${form.dataset.kind}`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({...data,lang:form.dataset.lang})});const result=await response.json();if(!response.ok)throw new Error(result.error||'SERVICE_UNAVAILABLE');const labels:Record<string,string>=en?{received:'Request received',pending:'Awaiting confirmation',confirmed:'Confirmed',payment_pending:'Awaiting payment',paid:'Paid',completed:'Completed',cancelled:'Cancelled'}:{received:'Solicitud recibida',pending:'Pendiente de confirmación',confirmed:'Confirmada',payment_pending:'Pendiente de pago',paid:'Pagada',completed:'Completada',cancelled:'Cancelada'};status.textContent=result.code?`${en?'Request received. Save your code':'Solicitud recibida. Guardá tu código'}: ${result.code}. ${en?'Awaiting confirmation.':'Pendiente de confirmación.'}`:result.status?labels[result.status]:(en?'Received. Our team will review it.':'Recibido. Nuestro equipo lo revisará.');if(form.dataset.kind!=='tracking')form.reset();}catch(error){const message=error instanceof Error?error.message:'';status.textContent=message==='NOT_FOUND'?(en?'No matching booking was found.':'No se encontró una reservación con esos datos.'):(en?'The service is not available yet. Please try again later.':'El servicio todavía no está disponible. Intentá de nuevo más tarde.');}finally{button.disabled=false;const turnstile=(window as any).turnstile;if(turnstile)turnstile.reset();}})});

</script></body></html>
